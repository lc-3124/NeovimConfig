{
  "layer": "top",
  "position": "top",
  "height": 16,
  "margin-top": 1,
  "margin-left": 2,
  "margin-right": 2,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["mpris"],
  "modules-right": ["tray", "network", "pulseaudio", "temperature", "cpu", "memory", "battery", "clock"],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "format": "{icon}",
    "on-click": "focus",
    "tooltip": true
  },

  "hyprland/window": {
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Mozilla Firefox":  " Firefox",
      "(.*) — Visual Studio Code": "  Code",
      "(.*) — Alacritty":        "  Terminal"
    },
    "format": "{}",
    "max-length": 36,
    "tooltip": true
  },

  "mpris": {
    "format": "♫ {player_name} — {title}",
    "format-paused": "♫ {title}  ⏸",
    "max-length": 40,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip-format": "{artist}\n{album}\n{title}"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "clock": {
    "format": " {:%H:%M}",
    "tooltip-format": "{:%A %Y-%m-%d}",
    "on-click": "sh -c 'gnome-calendar || thunderbird'",
    "tooltip": true
  },

  "cpu": {
    "format": " {usage}%",
    "on-click": "kitty -e htop",
    "tooltip": true
  },

  "memory": {
    "format": " {used:0.1f}G",
    "on-click": "kitty -e btop",
    "tooltip": true
  },

  "temperature": {
    "critical-threshold": 75,
    "warning-threshold": 65,
    "format": " {temperatureC}°C"
  },

  "battery": {
    "bat": "BAT0",
    "interval": 30,
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "on-click": "kitty -e powertop",
    "tooltip": true
  },

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": "󰈀 Wired",
    "format-disconnected": "⚠ Offline",
    "tooltip-format": "Up: {bandwidthUpBits}\nDown: {bandwidthDownBits}",
    "on-click": "nm-connection-editor",
    "tooltip": true
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "tooltip": false
  }
}
