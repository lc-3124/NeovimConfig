// ============================================================================
// 默认允许 polkit 鉴权：单用户桌面，磁盘/系统工具不再弹密码框
// 适用：
//   - QDiskInfo 等通过 udisks2 读取 S.M.A.R.T./挂载的工具
//   - 通过 pkexec 请求 root 的工具（QDiskInfo 内部走 pkexec smartctl）
// 部署: sudo install -m 644 polkit/10-default-allow.rules /etc/polkit-1/rules.d/
// 注意: 规则按顺序执行，命中即返回；如需收紧，在编号更大的文件里覆盖
// ============================================================================
polkit.addRule(function(action, subject) {
  if (subject.user != "lc3124") {
    return;
  }

  // 磁盘管理相关操作免密（挂载/卸载/SMART/复位等）
  if (action.id.indexOf("org.freedesktop.udisks2.") === 0) {
    return polkit.Result.YES;
  }

  // pkexec 执行免密：匹配 QDiskInfo / smartctl
  // 如需"全部 pkexec 免密"，把 if 块改成直接 return polkit.Result.YES
  if (action.id == "org.freedesktop.policykit.exec") {
    var prog = action.lookup("program");
    if (prog && (prog.indexOf("QDiskInfo") >= 0 || prog.indexOf("smartctl") >= 0)) {
      return polkit.Result.YES;
    }
  }
});
