#!/usr/bin/env zsh
# ============================================================
# 工作区布局恢复脚本：按固定顺序切换工作区并启动应用。
# 已在运行的应用自动跳过（幂等），可安全重复执行。
# 替代 hyprflow 会话恢复。
# ============================================================

source ~/.local/bin/hypr-instance 2>/dev/null

dispatch() { hyprctl dispatch workspace "$1" >/dev/null 2>&1; }

# ensure <匹配模式> <命令...>：匹配到的进程存在则跳过，否则后台启动
ensure() {
  local pat="$1"; shift
  pgrep -f "$pat" >/dev/null 2>&1 || "$@" &
}

# wait_geom <class> <title子串> <期望几何 "x y w h">：轮询窗口出现并校验几何一致
# 平铺窗口几何由布局按窗口顺序计算，顺序一致时自动复刻；此处兜底校验
wait_geom() {
  local class="$1" title="$2" want="$3"
  for _ in {1..60}; do
    geom=$(hyprctl clients -j 2>/dev/null | python3 -c "
import json,sys
for c in json.load(sys.stdin):
    if c.get('class')=='$class' and '$title' in c.get('title','') and c.get('mapped'):
        a,s=c.get('at'),c.get('size')
        print(f'{a[0]} {a[1]} {s[0]} {s[1]}'); break
")
    if [[ -n "$geom" ]]; then
      if [[ "$geom" != "$want" ]]; then
        echo "警告: [$class|$title] 几何 $geom ≠ 期望 $want（布局顺序或参数已变）" >&2
      fi
      return 0
    fi
    sleep 1
  done
  echo "警告: [$class|$title] 在 60 秒内未出现" >&2
  return 1
}

# --- 工作区 10：网络工具（启动最慢，先跑） ---
# FastLink 按当前比例恢复：平铺布局下以 eDP-1 (1920x1080@1.2, 逻辑 1600x900) 为准，
# 当前几何 at=[13,13] size=[1527,874]
dispatch 10
ensure "FastLink" fastlink
ensure "flclash" flclash
wait_geom "com.flclient.app" "" "13 13 1527 874"
sleep 20

# --- 工作区 1：浏览器 ---
dispatch 1
ensure "firefox" firefox
sleep 9

# --- 工作区 2：邮件 ---
dispatch 2
ensure "thunderbird" thunderbird
sleep 9

# --- 工作区 3：QQ ---
dispatch 3
ensure "/opt/QQ/qq" linuxqq
sleep 20

# --- 工作区 5：终端 ---
dispatch 5
ensure "kitty" kitty
sleep 5

# --- 工作区 9：严格按当前布局恢复 ---
# dwindle 平铺布局：fooyin 主窗（左），右侧自顶向下 4 个堆叠。
# 平铺几何由窗口创建顺序计算，恢复关键 = 保持启动顺序一致：
#   fooyin → pipes.sh → pavucontrol → cava → activate-linux
# 期望几何（eDP-1 逻辑 1600x900）:
#   fooyin         [13,13]    1154x874
#   pipes.sh       [1189,13]  351x207
#   pavucontrol    [1189,242] 351x328
#   cava           [1189,592] 351x132
#   activate-linux [1189,746] 351x141
dispatch 9
ensure "fooyin" fooyin
wait_geom "org.fooyin.fooyin" "" "13 13 1154 874"
ensure "pipes.sh" kitty -e pipes.sh
wait_geom "kitty" "pipes.sh" "1189 13 351 207"
ensure "pavucontrol" pavucontrol
wait_geom "org.pulseaudio.pavucontrol" "" "1189 242 351 328"
ensure "cava" kitty -e cava
wait_geom "kitty" "cava" "1189 592 351 132"
ensure "activate-linux" kitty -e activate-linux -o
wait_geom "kitty" "activate-linux" "1189 746 351 141"